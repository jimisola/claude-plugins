{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(*skills/upload/scripts/attach.ts*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-upload.ts\""
          },
          {
            "type": "command",
            "if": "Bash(*uploads.github.com/user-attachments*)",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/check-upload.ts\""
          }
        ]
      }
    ]
  }
}
